<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Salsa — Pizza Bar Latino</title>
<meta name="description" content="Pizza bar latino. Quinta a sáb. A cozinha fecha 01h, o bar continua. Não fazemos reservas. Menu itinerante.">
<meta name="theme-color" content="#120F0D">
<meta property="og:title" content="Salsa — Pizza Bar Latino">
<meta property="og:description" content="Quinta a sáb. A cozinha fecha 01h, o bar continua. Menu itinerante.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#120F0D;
    --bg2:#181310;
    --card:#1A1511;
    --card-line:rgba(255,255,255,.07);
    --inativo:#24201C;
    --inativo-hi:#382114;
    --vermelho:#FF3A41;
    --laranja:#FF6721;
    --ambar:#FFA709;
    --txt:#FFFFFF;
    --txt-dim:#8A8177;
    --eyebrow:#FF9887;
    --grad:linear-gradient(100deg,var(--vermelho) 0%,var(--laranja) 52%,var(--ambar) 100%);
  }

  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%}

  body{
    background:var(--bg);
    color:var(--txt);
    font-family:'Archivo',system-ui,-apple-system,sans-serif;
    min-height:100vh;
    display:flex;
    justify-content:center;
    padding:0 20px 60px;
    position:relative;
    overflow-x:hidden;
  }

  /* brasa ambiente ao fundo */
  body::before{
    content:"";
    position:fixed;
    inset:0;
    background:
      radial-gradient(680px 420px at 50% -8%,  rgba(255,103,33,.16), transparent 70%),
      radial-gradient(520px 380px at 8% 92%,   rgba(255,58,65,.09),  transparent 70%),
      radial-gradient(520px 380px at 95% 78%,  rgba(255,167,9,.08),  transparent 70%),
      var(--bg2);
    z-index:-1;
  }

  /* faíscas */
  .spark{
    position:fixed;
    width:3px;height:3px;
    border-radius:50%;
    opacity:.5;
    z-index:-1;
    animation:float 9s ease-in-out infinite;
  }
  @keyframes float{
    0%,100%{transform:translateY(0);opacity:.2}
    50%    {transform:translateY(-16px);opacity:.65}
  }

  .wrap{width:100%;max-width:392px}

  /* ---------- WORDMARK ---------- */
  header{padding:56px 0 34px;text-align:center}

  .wordmark{
    font-family:'Archivo Black',Impact,sans-serif;
    font-size:clamp(60px,17vw,74px);
    line-height:.9;
    letter-spacing:-.012em;
    background:var(--grad);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    -webkit-text-fill-color:transparent;
    filter:drop-shadow(0 0 34px rgba(255,103,33,.42));
  }

  .kicker{
    margin-top:12px;
    font-size:11px;
    font-weight:500;
    letter-spacing:.46em;
    text-indent:.46em;
    text-transform:uppercase;
    color:var(--txt-dim);
  }

  /* ---------- CARD ---------- */
  .card{
    background:var(--card);
    border:1px solid var(--card-line);
    border-radius:20px;
    padding:26px 22px 24px;
    box-shadow:0 24px 60px rgba(0,0,0,.55);
  }

  .card-title{
    text-align:center;
    font-size:12.5px;
    font-weight:500;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:var(--txt-dim);
    margin-bottom:20px;
  }

  /* ---------- BOTÕES ---------- */
  .links{display:flex;flex-direction:column;gap:11px}

  .link{
    display:flex;
    align-items:center;
    gap:13px;
    padding:13px 15px;
    border-radius:13px;
    text-decoration:none;
    color:var(--txt);
    background:var(--inativo);
    border:1px solid rgba(255,255,255,.06);
    transition:transform .16s ease, filter .16s ease, background .16s ease;
  }
  .link:hover,.link:focus-visible{transform:translateY(-2px)}
  .link:focus-visible{outline:2px solid var(--ambar);outline-offset:3px}

  /* botão principal com o gradiente da marca */
  .link.primary{
    background:var(--grad);
    border-color:transparent;
    box-shadow:0 8px 26px rgba(255,103,33,.34);
  }
  .link.primary:hover{filter:brightness(1.07)}
  .link.primary .eyebrow{color:rgba(255,255,255,.82)}
  .link.primary .arw{color:rgba(255,255,255,.75)}

  /* segundo nível: leve calor */
  .link.warm{background:var(--inativo-hi)}
  .link.warm:hover{background:#432717}
  .link:not(.primary):hover{background:#2C2723}

  .ico{
    flex:0 0 34px;height:34px;
    display:grid;place-items:center;
    border-radius:9px;
    background:rgba(0,0,0,.26);
    font-size:17px;
    line-height:1;
  }
  .link.primary .ico{background:rgba(255,255,255,.2)}

  /* ícone oficial do WhatsApp */
  .ico-wa{background:#25D366}
  .ico-wa svg{width:21px;height:21px;fill:#0B140F;display:block}

  .txt{flex:1;min-width:0}

  .eyebrow{
    display:block;
    font-size:9.5px;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--eyebrow);
    margin-bottom:2px;
  }
  .label{
    display:block;
    font-size:15.5px;
    font-weight:700;
    letter-spacing:-.005em;
    line-height:1.25;
  }
  .arw{font-size:17px;color:var(--txt-dim);flex:0 0 auto}

  /* ---------- INFO ---------- */
  .info{
    margin-top:22px;
    text-align:center;
    font-size:12.5px;
    line-height:1.95;
    color:var(--txt-dim);
  }
  .info b{color:var(--ambar);font-weight:600}
  .info .roam{
    display:block;
    margin-top:9px;
    color:var(--laranja);
    font-weight:600;
    letter-spacing:.02em;
  }

  footer{
    margin-top:26px;
    text-align:center;
    font-size:10px;
    letter-spacing:.24em;
    text-transform:uppercase;
    color:#544C44;
    line-height:2;
  }

  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
  }
</style>
</head>
<body>

<span class="spark" style="top:24%;left:7%; background:#FF6721; animation-delay:0s"></span>
<span class="spark" style="top:68%;left:4%; background:#FF3A41; animation-delay:1.4s"></span>
<span class="spark" style="top:41%;right:6%;background:#FFA709; animation-delay:2.6s"></span>
<span class="spark" style="top:82%;right:9%;background:#FF6721; animation-delay:3.9s"></span>

<div class="wrap">

  <header>
