        <span class="txt">
          <span class="eyebrow">Siga a gente</span>
          <span class="label">@salsacocina</span>
        </span>
        <span class="arw" aria-hidden="true">&rsaquo;</span>
      </a>

      <a class="link" href="https://share.google/8vB3f0QTX5gnjLag9" target="_blank" rel="noopener">
